# Database
DATABASE_URL=postgresql://user:password@localhost:5432/resonans
# Hvilken driver DATABASE_URL skal snakkes med: `postgres` (vanlig TCP) eller
# `neon-http`. Uten variabelen utledes den av verten — bare en Neon-vert får
# HTTP-driveren. Sett den eksplisitt hvis du er i tvil; se
# src/lib/db/driver-choice.ts for hvorfor gjetningen ikke er til å stole på.
# DB_DRIVER=postgres
# Poolstørrelse for postgres-driveren (default 10). Ignoreres av neon-http.
# DB_POOL_MAX=10

# LLM API (velg en)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Web Push / PWA notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_public_vapid_key_here
VAPID_PRIVATE_KEY=your_private_vapid_key_here
VAPID_SUBJECT=mailto:hello@example.com

# Withings API (for health data integration)
# Get credentials at: https://developer.withings.com/
WITHINGS_CLIENT_ID=your_client_id_here
WITHINGS_CLIENT_SECRET=your_client_secret_here

# Dropbox API (for TCX/GPX workout file import)
# Create an app at: https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=your_client_id_here
DROPBOX_CLIENT_SECRET=your_client_secret_here

# SpareBank 1 API (read-only bank data integration)
# OAuth docs: https://developer.sparebank1.no/
SPAREBANK1_CLIENT_ID=your_client_id_here
SPAREBANK1_CLIENT_SECRET=your_client_secret_here
# Optional overrides (defaults are set in code)
# SPAREBANK1_API_BASE_URL=https://api.sparebank1.no
# SPAREBANK1_FINANCIAL_INSTITUTION=fid-smn
# SPAREBANK1_SCOPES=accounts
# SPAREBANK1_AUTHORIZE_ENDPOINT=/oauth/authorize
# SPAREBANK1_TOKEN_ENDPOINT=/oauth/token
# SPAREBANK1_HELLOWORLD_ENDPOINT=/common/helloworld
# Data endpoints (defaults are correct for SpareBank 1 prod):
# SPAREBANK1_ACCOUNTS_ENDPOINT=/personal/banking/accounts
# SPAREBANK1_TRANSACTIONS_ENDPOINT=/personal/banking/transactions

# Tesla Fleet API (kjøretøy som sensor + live-kontekst, read-only)
# Lag en utviklerapp på https://developer.tesla.com/
# Krever i tillegg engangs partner-registrering der Tesla henter en public key fra
# https://<domene>/.well-known/appspecific/com.tesla.3p.public-key.pem (statisk fil).
TESLA_CLIENT_ID=your_client_id_here
TESLA_CLIENT_SECRET=your_client_secret_here
# Valgfri override av regional base-URL (default = EU). Settes normalt automatisk
# via region-oppslaget etter innlogging.
# TESLA_FLEET_BASE_URL=https://fleet-api.prd.eu.vn.cloud.tesla.com

# Tavily Search API (for bok-kontekst-samling: kritikeranmeldelser, lesermottak)
# Sign up at: https://tavily.com — gratis tier dekker normalt bruk
TAVILY_API_KEY=tvly-...

# App
PUBLIC_APP_NAME=Resonans

# ── Drift ────────────────────────────────────────────────────────────────
# Appens egen adresse. Brukes til lenker i nudger og e-post, og av
# adapter-node til CSRF-sjekken. Uten den nekter scheduleren å starte og
# partnerinvitasjoner sendes ikke — en gjettet adresse ville tatt mottakeren
# til feil sted. Se src/lib/server/app-origin.ts.
ORIGIN=http://localhost:5174

# Hemmeligheten cron- og scheduler-endepunktene krever. Deployet nekter appen
# å starte uten den (src/lib/server/boot-checks.ts); lokalt er den valgfri.
# CRON_SECRET=

# Google OAuth. Deployet nekter appen å starte uten disse — hooken ville
# ellers sluppet ALLE forespørsler gjennom.
#
# NB: AUTH_SECRET er OGSÅ krypteringsnøkkelen for lagrede tokens (crypto.ts
# leser TOKEN_ENCRYPTION_KEY || AUTH_SECRET, og den første er ikke satt noe
# sted). Bytter du den, er krypterte Strava- og Tesla-credentials tapt — uten
# feilmelding. Ikke sett TOKEN_ENCRYPTION_KEY «for ryddighetens skyld»: det er
# samme skade. Se CLAUDE.md.
AUTH_SECRET=
# AUTH_GOOGLE_ID / GOOGLE_CLIENT_ID og AUTH_GOOGLE_SECRET / GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AUTH_ALLOWED_EMAILS=deg@example.com

# Låser diagnoseheaderen x-resonans-user-id. Uten den godtas headeren uten
# hemmelighet — bevisst fail-open, se src/lib/server/user-header-auth.ts.
# RESONANS_HEADER_SECRET=

# In-app cron. Nøyaktig ÉN instans må ha denne på; to containere ville sendt
# hver sin nudge.
# ENABLE_IN_APP_SCHEDULER=true

# ── Kun for containeren (settes i Dockerfile, ikke her) ──────────────────
# BODY_SIZE_LIMIT=25M      adapter-node defaulter til 512 kB
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
